{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:learning-platform:learning-path-draft:1.0",
  "title": "Portable Learning Path Draft 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "description",
    "language",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "nodes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "rule"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "rule": {
          "enum": [
            "self",
            "approval"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "parentId",
        "order",
        "title",
        "body",
        "estimatedMinutes",
        "difficulty",
        "tags",
        "completion",
        "resourceUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "kind": {
          "enum": [
            "stage",
            "module",
            "lesson",
            "task",
            "exercise",
            "project",
            "resource"
          ]
        },
        "parentId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "maxLength": 200000
        },
        "estimatedMinutes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          ]
        },
        "difficulty": {
          "enum": [
            null,
            "beginner",
            "intermediate",
            "advanced"
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "completion": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/completion"
            }
          ]
        },
        "resourceUrl": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          ]
        }
      }
    }
  }
}
