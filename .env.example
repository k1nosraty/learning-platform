# Copy to .env; replace development credentials before any deployment.
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
MAIL_ENCRYPTION_KEY=replace-with-a-64-character-hex-key
DATABASE_MIGRATION_URL=postgres://postgres:development@localhost:5432/learning
DATABASE_AUTH_URL=postgres://learning_auth:development-auth@localhost:5432/learning
DATABASE_URL=postgres://learning_app:development-app@localhost:5432/learning
DATABASE_WORKER_URL=postgres://learning_worker:development-worker@localhost:5432/learning
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Learning Platform <no-reply@localhost.test>
# SMTP_USER=
# SMTP_PASSWORD=
